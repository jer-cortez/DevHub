FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir \
    'pydantic>=2.10,<3' 'tree-sitter>=0.25,<0.26' \
    'tree-sitter-javascript>=0.25,<0.26' 'tree-sitter-typescript>=0.23,<0.24'
ENV PATH="/opt/venv/bin:$PATH" PYTHONPATH=/opt/audit PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/audit
RUN npm install --ignore-scripts --no-audit --no-fund typescript@6.0.3 && touch /opt/audit/empty-global.npmrc
COPY auditor/ /opt/audit/auditor/
COPY analysis/ /opt/audit/
USER 1000:1000
WORKDIR /workspace
