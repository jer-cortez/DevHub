DATABASE_URL=postgresql://user:password@localhost:5432/devhub
REDIS_URL=redis://localhost:6379
# The auditor defaults to OpenAI. For local development this may instead be
# stored in server/.env; the worker loads that file as a fallback without
# replacing values already present in the process or agent/.env.
OPENAI_API_KEY=
# Optional alternative used only when AGENT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-5.6-sol
AGENT_REASONING_EFFORT=low
AUDIT_ENABLED=false
AUDIT_PROFILES_PATH=/absolute/path/to/agent/profiles.json
AUDIT_GITHUB_APP_ID=
AUDIT_GITHUB_INSTALLATION_ID=
AUDIT_GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem
# Empty means local Docker. Remote host must be in known_hosts, BatchMode SSH.
AUDIT_RUNNER_HOST=
AUDIT_MAX_SECONDS=1200
AUDIT_MAX_CALLS=12
AUDIT_MAX_INPUT_TOKENS=120000
AUDIT_MAX_OUTPUT_TOKENS=16000
