# Copy to client/.env.local on the EC2 instance and fill in real values.
# NEXT_PUBLIC_SUPABASE_* are the same values already in your local
# client/.env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The deployed hostname, no port. nginx terminates TLS on 443 and proxies
# /api/ and /ws/ to the Express server (see deploy/nginx.conf.template), so
# the browser calls the API same-origin — no port, no separate host.
#
# This is baked into the client bundle at BUILD time, not read at runtime —
# changing it later requires `npm run build` again, not just a restart.
# useBoardSocket.ts derives the WebSocket URL from this by swapping the
# `http`/`https` prefix for `ws`/`wss`, so getting the scheme right here
# (https, not http) is also what makes board sockets use wss:// instead of
# failing to upgrade over TLS.
#
# REPLACE_ME is not valid on its own — swap the whole value for your actual
# domain (e.g. https://100-49-73-135.sslip.io), then `npm run build` again.
NEXT_PUBLIC_API_URL=https://REPLACE_ME
