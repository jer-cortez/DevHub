# Copy to server/.env on the EC2 instance and fill in real values.
# DATABASE_URL / SUPABASE_* / GITHUB_* are the same values already in your
# local server/.env — copy them over (e.g. via `scp server/.env ubuntu@<IP>:~/app/server/.env`
# rather than retyping secrets by hand).

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=

GITHUB_APP_TOKEN=
GITHUB_ORG_NAME=

# Must match, character for character, the "Secret" field you set on the
# GitHub webhook itself — see deploy/README.md. If these differ, every
# delivery fails signature verification and webhooks.controller.ts returns
# 401 for all of them.
GITHUB_WEBHOOK_SECRET=

# Powers the PR summary and org-health AI features. Same value as your local
# server/.env — get a key at console.anthropic.com if you don't have one.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5 if omitted. See server/src/lib/anthropic.ts.
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5

# Points at the Redis instance started by setup.sh (apt package, bound to
# localhost only via /etc/redis/redis.conf) — never exposed outside this box.
REDIS_URL=redis://localhost:6379

# Restricts the API's CORS policy to the deployed frontend. With nginx
# proxying both apps under one hostname, the browser calls the API
# same-origin and CORS is not actually consulted for normal traffic — this
# is defense-in-depth in case anything ever reaches port 8080 directly.
CLIENT_ORIGIN=https://<DOMAIN>
