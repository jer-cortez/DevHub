# Optional inputs read by deploy/audit-runner-setup.sh. Export them or copy
# this file outside the repository and source it before running the script.

# The application host accepts only these prebuilt runner image names.
AUDIT_RUNNER_IMAGES=devhub-audit-node:22

# `latest` is convenient for initial setup but is mutable. Production
# operators should replace it with an image digest they have reviewed, e.g.
# ubuntu/squid@sha256:<digest>. The setup script deliberately makes the image
# an operator override and does not claim the tag is pinned.
AUDIT_SQUID_IMAGE=ubuntu/squid:latest

# Optional: install the application host's public key into authorized_keys.
# The setup script prints the exact restricted entry if this is left empty.
# AUDIT_WORKER_PUBLIC_KEY_FILE=/absolute/path/to/id_ed25519.pub
# AUDIT_WORKER_SOURCE=10.0.1.25

# Docker Desktop on macOS is allowed only for local development. This escape
# hatch is rejected on Linux, where the runner must use rootless Docker.
# AUDIT_LOCAL_DOCKER=1
