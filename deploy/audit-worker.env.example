# Install as /etc/devhub/auditor.env on the application host, owned by root
# with mode 0600. Values are read by deploy/audit-worker.service.
DATABASE_URL=postgresql://user:password@database:5432/devhub
REDIS_URL=redis://127.0.0.1:6379
# Production workers keep their own provider key in this root-owned file.
OPENAI_API_KEY=
# Optional alternative used only when AGENT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-5.6-sol
AGENT_REASONING_EFFORT=low

# Both this process and the API must be enabled, and audit_control.enabled
# must be true, before work is claimed. Keep false through offline checks.
AUDIT_ENABLED=false
AUDIT_PROFILES_PATH=/srv/github-extension/agent/profiles.json

# Use the same GitHub App identity on the API and worker hosts. Store the PEM
# outside the repository and make it readable only by the worker service user.
AUDIT_GITHUB_APP_ID=
AUDIT_GITHUB_INSTALLATION_ID=
AUDIT_GITHUB_PRIVATE_KEY_PATH=/etc/devhub/audit-github-app.pem

# SSH alias or user@private-host for the isolated runner. Leave empty only in
# local development, where the worker invokes the local Docker runner.
AUDIT_RUNNER_HOST=audit-runner@10.0.2.25
AUDIT_MAX_SECONDS=1200
AUDIT_MAX_CALLS=12
AUDIT_MAX_INPUT_TOKENS=120000
AUDIT_MAX_OUTPUT_TOKENS=16000

# LangSmith tracing is optional. The auditor does not require a LangSmith
# account. Uncomment all three only when tracing has been intentionally set up.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=devhub-auditor
