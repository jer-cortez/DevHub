generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  github_id       Int               @unique
  username        String
  avatar_url      String?
  email           String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  pr_dependencies pr_dependencies[]

  @@map("users")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pull_request {
  id                                                           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  github_pr_id                                                 BigInt            @unique
  github_pr_number                                             Int
  repo_id                                                      String            @db.Uuid
  author_id                                                    String            @db.Uuid
  title                                                        String            @db.VarChar
  body                                                         String?
  status                                                       String            @default("open") @db.VarChar
  base_branch                                                  String            @db.VarChar
  head_branch                                                  String            @db.VarChar
  github_url                                                   String            @db.VarChar
  last_synced_at                                               DateTime?         @db.Timestamp(6)
  created_at                                                   DateTime          @default(now()) @db.Timestamp(6)
  closed_at                                                    DateTime?         @db.Timestamp(6)
  merged_at                                                    DateTime?         @db.Timestamp(6)
  head_sha                                                     String?           @db.VarChar
  summary                                                      String?
  summary_impact                                               String?
  summary_sha                                                  String?           @db.VarChar
  summary_model                                                String?           @db.VarChar
  summary_truncated                                            Boolean           @default(false)
  summarized_at                                                DateTime?         @db.Timestamp(6)
  pr_dependencies_pr_dependencies_blocked_pr_idTopull_request  pr_dependencies[] @relation("pr_dependencies_blocked_pr_idTopull_request")
  pr_dependencies_pr_dependencies_blocking_pr_idTopull_request pr_dependencies[] @relation("pr_dependencies_blocking_pr_idTopull_request")

  @@index([status, repo_id], map: "pull_request_status_repo_idx")
  @@index([repo_id], map: "pull_request_summary_stale_idx", where: raw("((summary_sha IS NULL) OR ((summary_sha)::text IS DISTINCT FROM (head_sha)::text))"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drawing_board_collaborators {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  board_id   String   @db.Uuid
  user_id    String   @db.Uuid
  permission String   @db.VarChar
  added_at   DateTime @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drawing_boards {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repo_id    String   @db.Uuid
  created_by String   @db.Uuid
  type       String   @db.VarChar
  title      String   @db.VarChar
  nodes      Json
  edges      Json
  updated_at DateTime @updatedAt @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar
  pr_id      String?  @db.Uuid
  board_id   String?  @db.Uuid
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  issue_id   String?  @db.Uuid
  comment_id String?  @db.Uuid
  repo_id    String?  @db.Uuid
  actor_id   String?  @db.Uuid
  is_direct  Boolean  @default(false)
  title      String?  @db.VarChar
  url        String?  @db.VarChar

  @@index([user_id, created_at(sort: Desc)], map: "notifications_user_created_idx")
  @@index([user_id, is_read], map: "notifications_user_unread_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model organization_members {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id    String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  joined_at DateTime @db.Timestamp(6)

  @@unique([user_id, org_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model organizations {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  github_org_id BigInt   @unique
  name          String   @db.VarChar
  avatar_url    String   @db.VarChar
  created_at    DateTime @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pull_request_reviewers {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pr_id       String    @db.Uuid
  user_id     String    @db.Uuid
  status      String    @db.VarChar
  reviewed_at DateTime? @db.Timestamptz(6)
  assigned_at DateTime  @db.Timestamp(6)

  @@unique([pr_id, user_id], map: "pull_request_reviewers_pr_user_key")
  @@index([user_id, status], map: "pull_request_reviewers_user_status_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model repo_followers {
  id                   BigInt   @id @default(autoincrement())
  user_id              String   @db.Uuid
  repo_id              String   @db.Uuid
  followed_at          DateTime @default(now()) @db.Timestamp(6)
  notify_pull_requests Boolean  @default(true)
  notify_issues        Boolean  @default(false)
  notify_comments      Boolean  @default(false)

  @@unique([user_id, repo_id], map: "repo_followers_user_repo_key")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model repositories {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  github_repo_id BigInt   @unique
  org_id         String   @db.Uuid
  name           String   @db.VarChar
  description    String   @db.VarChar
  is_private     Boolean
  default_branch String   @db.VarChar
  last_synced_at DateTime @db.Timestamp(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model review_comments {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  github_comment_id BigInt   @unique
  review_id         String?  @db.Uuid
  pr_id             String?  @db.Uuid
  author_id         String   @db.Uuid
  body              String
  file_path         String?  @db.VarChar
  line_number       Int?
  is_resolved       Boolean
  created_at        DateTime @default(now()) @db.Timestamp(6)
  issue_id          String?  @db.Uuid

  @@index([issue_id])
  @@index([pr_id, created_at(sort: Desc)], map: "review_comments_pr_created_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reviews {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  github_review_id BigInt   @unique
  pr_id            String   @db.Uuid
  reviewer_id      String   @db.Uuid
  decision         String   @db.VarChar
  body             String?
  submitted_at     DateTime @db.Timestamptz(6)

  @@index([pr_id, submitted_at(sort: Desc)], map: "reviews_pr_submitted_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model issues {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  github_issue_id     BigInt    @unique
  github_issue_number Int
  repo_id             String    @db.Uuid
  author_id           String    @db.Uuid
  assignee_id         String?   @db.Uuid
  title               String    @db.VarChar
  body                String?
  status              String    @default("open") @db.VarChar
  github_url          String    @db.VarChar
  last_synced_at      DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  closed_at           DateTime? @db.Timestamp(6)

  @@index([repo_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model team_memberships {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @unique @db.Uuid
  repo_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([repo_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pr_dependencies {
  id                                                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocked_pr_id                                             String       @db.Uuid
  blocking_pr_id                                            String       @db.Uuid
  note                                                      String?
  created_by                                                String       @db.Uuid
  created_at                                                DateTime     @default(now()) @db.Timestamptz(6)
  pull_request_pr_dependencies_blocked_pr_idTopull_request  pull_request @relation("pr_dependencies_blocked_pr_idTopull_request", fields: [blocked_pr_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pull_request_pr_dependencies_blocking_pr_idTopull_request pull_request @relation("pr_dependencies_blocking_pr_idTopull_request", fields: [blocking_pr_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                                     User         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([blocked_pr_id, blocking_pr_id], map: "pr_dependencies_pair_key")
  @@index([blocked_pr_id], map: "pr_dependencies_blocked_idx")
  @@index([blocking_pr_id], map: "pr_dependencies_blocking_idx")
}
