generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  github_id  Int      @unique
  username   String
  avatar_url String?
  email      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("users")
}
